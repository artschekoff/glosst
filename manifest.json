{
  "manifest_version": 3,
  "name": "Glosst",
  "version": "0.1.0",
  "description": "Перевод предложения под курсором по Alt, без изменения страницы.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "src/bg/index.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "src/content/boot.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
